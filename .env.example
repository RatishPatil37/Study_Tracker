# StudyOS Environment Configuration Example
# Copy this file to .env.local for local overrides.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Supabase Configuration (Optional for local mode; required for Supabase Cloud integration)
# Replace with your actual project URL and anon public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini API Configuration (Server-side proxy only; NEVER expose to client)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Local Storage Database Path (Used for local offline mode / fallback)
STUDYOS_DB_PATH=./data/studyos.db
